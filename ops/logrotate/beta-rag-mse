# Log rotation for RAG Schießsport MSE
# Install: cp ops/logrotate/beta-rag-mse /etc/logrotate.d/beta-rag-mse
#
# Hinweis: Der E-Mail-Dev-Modus (EMAIL_DEV_LOG_METHOD="file"/"both") schreibt
# einzelne .eml-Dateien (eine Datei pro E-Mail), keine fortlaufenden Logdateien.
# Logrotate-Rotation passt dafür nicht — alte .eml-Dateien stattdessen
# altersbasiert per Cron löschen:
#   0 3 * * * find /zfs/git/beta-rag-mse/data/logs/emails -name '*.eml' -mtime +14 -delete

/zfs/git/beta-rag-mse/data/logs/emails/*.log {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    create 0640 1000 1000
}
