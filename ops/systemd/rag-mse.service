# Rootless Podman boot-persistence for the RAG MSE stack (app).
#
# Install as a *user* unit (rootless), then enable lingering so it survives
# logout/reboot:
#
#   mkdir -p ~/.config/systemd/user
#   cp ops/systemd/rag-mse.service ~/.config/systemd/user/rag-mse.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now rag-mse
#   loginctl enable-linger "$USER"
#
# deploy.sh drives podman-compose directly during deploys; this unit only
# ensures the stack comes back up after a reboot. Adjust the podman-compose
# path below if it is not on the default PATH.

[Unit]
Description=RAG MSE app stack (rootless Podman / podman-compose)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/zfs/git/beta-rag-mse
ExecStart=/home/linux/.local/bin/podman-compose -f compose.yaml up
ExecStop=/home/linux/.local/bin/podman-compose -f compose.yaml down
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
